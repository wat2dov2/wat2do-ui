SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key
# Service role key for backend table access (bypasses RLS). Dashboard > Settings > API Keys.
SUPABASE_SECRET_KEY=your-service-role-key
# JWT secret for local token verification (skips Supabase auth round-trip).
# Dashboard > Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=your-jwt-secret
# Used by the Supabase CLI / psql for migrations. The FastAPI runtime
# talks to Supabase over HTTPS (PostgREST) and does NOT read this — so we
# just use the session pooler (port 5432), which is required for DDL.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# CORS allowed origins (JSON list).
# Defaults to ["http://localhost:5173","http://localhost:3000"] for local dev.
# MUST be set to real domains in production — wildcard "*" is rejected at startup.
# CORS_ORIGINS=["https://wat2do.app","https://www.wat2do.app"]

# Cookie security. Defaults to true (HTTPS-only cookies).
# Set to false only for local HTTP development.
# COOKIE_SECURE=false

# Cookie domain. Leave empty for local dev (browser defaults to request host).
# Set to your domain in production so cookies work across subdomains.
# COOKIE_DOMAIN=.wat2do.app

# Email provider for notifications (notifications v1).
# Leave empty for DRY-RUN mode (log-only; nothing is actually sent).
# Set to ``resend`` or ``postmark`` when wiring the real provider.
# EMAIL_PROVIDER=
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=wat2do <notifications@wat2do.app>
