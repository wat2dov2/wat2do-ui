# PostgREST data API in front of Postgres, and the service JWT (role service_role)
# signed with the data API's JWT secret that every backend request carries.
DATA_API_URL=http://localhost:55433
DATA_API_KEY=your-service-jwt
# Signs our access tokens: base64 PKCS#8 DER of an EC P-256 private key, made with
# openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -outform DER | base64
AUTH_SIGNING_KEY=your-signing-key
# Google sign-in client secret (client id is in controlbox/authentication.json).
GOOGLE_OAUTH_CLIENT_SECRET=
# Direct Postgres connection for migrations, psql and the Rust services. The
# FastAPI runtime talks to the data API over HTTPS and does not read it.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/wat2do

# CORS allowed origins (JSON list).
# Defaults to ["http://localhost:3000"] for local dev.
# MUST be set to real domains in production — wildcard "*" is rejected at startup.
# CORS_ORIGINS=["https://wat2do.io","https://www.wat2do.io"]

# Cookie security. Defaults to true (HTTPS-only cookies).
# Set to false only for local HTTP development.
# COOKIE_SECURE=false

# Shared session cookies: use *.wat2do.localhost locally and *.wat2do.io in production.
# COOKIE_DOMAIN=.wat2do.localhost
# REFRESH_COOKIE_PATH=/api/auth/refresh
# CORS_ORIGINS=["http://wat2do.localhost:3000"]
# CORS_ORIGIN_REGEX=^http://[a-z0-9-]+[.]wat2do[.]localhost:3000$
# COOKIE_DOMAIN=.wat2do.io

# Public URL path that receives the anonymous promoter visitor cookie.
# Keep /qr when calling FastAPI directly. Production proxies it through /api.
# POSTER_VISITOR_COOKIE_PATH=/qr

# Uploaded and ingested media: an absolute directory with one folder per bucket
# (event-images, avatars, ...), which the web server serves at
# STORAGE_PUBLIC_BASE_URL. make dev sets both for its containers.
# MEDIA_ROOT=/absolute/path/to/media
# STORAGE_PUBLIC_BASE_URL=https://wat2do.io/media

# Email goes out through Amazon SES in AWS_REGION with the runtime's AWS credentials.
# Leave false for DRY-RUN mode (log-only; nothing is actually sent).
# make dev sends for real: set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# for an IAM user allowed ses:SendEmail.
# EMAIL_DELIVERY_ENABLED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# EMAIL_FROM=wat2do <notifications@wat2do.io>
# EMAIL_UNSUBSCRIBE_SECRET=
# Bearer key the production EventBridge schedule sends to
# POST /webhooks/event-change-alerts every minute; Terraform reads the same
# value from the EVENT_CHANGE_ALERTS_KEY GitHub secret.
# EVENT_CHANGE_ALERTS_KEY=

# Public frontend URL used in password-reset links.
# FRONTEND_URL=http://wat2do.localhost:3000

# Optional Next.js event-feed ISR invalidation endpoint.
# Leave URL empty for local dry-run mode.
# EVENT_FEED_REVALIDATION_URL=http://localhost:3000/api/revalidate-events
# EVENT_FEED_REVALIDATION_SECRET=shared-secret
# EVENT_FEED_REVALIDATION_TIMEOUT=3.0

# Required for promoter poster scans. Keep these independent random secrets in
# the production secret manager. Rotating POSTER_HASH_SECRET changes anonymous
# visitor identities, so coordinate rotation with payout-period closure.
# POSTER_HASH_SECRET=replace-with-a-long-random-secret
# POSTER_CONFIRMATION_SECRET=replace-with-another-long-random-secret

# Apify token for the Instagram scraper (services/scraper).
# Required by the process-single-user workflow.
# Empty string => the scraping pipeline raises at startup.
# APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxx

# Override the vision-capable OpenAI model used for extraction and reconciliation.
# Defaults to gpt-6-luna. See services/scraper/extractor.py.
# OPENAI_EXTRACTION_MODEL=gpt-6-luna

# Text model used to select daily Instagram publishing candidates.
# OPENAI_INSTAGRAM_CURATION_MODEL=gpt-5.6-sol
# OPENAI_INSTAGRAM_CURATION_TIMEOUT=60

# Server-only Fernet key used to encrypt per-account Instagram tokens at rest.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the real value in backend/.env locally and AWS Secrets Manager in production.
# INSTAGRAM_TOKEN_ENCRYPTION_KEY=replace-me
