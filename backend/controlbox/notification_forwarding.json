{
  "github_repo": "wat2dov2/wat2do-ui",
  "dispatch_event_type": "new_instagram_post",
  "push_categories": ["post", "subscription_daily_digest"],
  "check_seconds": 5,
  "boot_settle_seconds": 300,
  "restart_after_stopped_minutes": 20,
  "quiet_foreground_seconds": 120,
  "max_load_average": 8,
  "min_available_megabytes": 700,
  "send_spacing_seconds": 1,
  "retry_first_seconds": 30,
  "retry_longest_seconds": 1800,
  "refusals_before_drop": 3,
  "dispatch_timeout_seconds": 30,
  "remember_days": 7,
  "log_max_bytes": 1048576,
  "log_backup_count": 3,
  "launch_agent_timeout_seconds": 30
}
