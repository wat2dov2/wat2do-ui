{
  "watchdog_interval_minutes": 60,
  "agent_hour": 17,
  "agent_minute": 0,
  "model": "claude-opus-5-5",
  "claude_config_dir": "~/.claude-second",
  "agent_timeout_minutes": 150,
  "move_timeout_minutes": 20,
  "trigger_debounce_hours": 2,
  "triggered_runs_per_day": 4,
  "report_dir": "~/Desktop/wat2do-reports",
  "launch_agent_timeout_seconds": 30,
  "probe_model": "claude-haiku-5-5",
  "probe_timeout_seconds": 120,
  "command_timeout_seconds": 60,
  "ingestion_window_hours": 6,
  "baseline_days": 7,
  "ingestion_window_min_ratio": 0.25,
  "ingestion_window_min_baseline": 150,
  "ingestion_day_min_ratio": 0.4,
  "ingestion_silence_minutes": 120,
  "school_dark_min_baseline": 40,
  "school_dark_ratio": 0.1,
  "school_low_ratio": 0.25,
  "school_digest_hours": 32,
  "brave_heartbeat_max_seconds": 600,
  "brave_window_hours": 3,
  "brave_job_failure_ratio": 0.3,
  "brave_job_min_jobs": 5,
  "brave_error_lines_per_hour": 60,
  "recorder_silence_minutes": 90,
  "recorder_quiet_until_hour": 8,
  "recorder_user_silence_hours": 14,
  "digest_silence_hours": 30,
  "dispatch_waiting_max": 20,
  "workflow_file": "handle-notification.yml",
  "workflow_window_hours": 6,
  "workflow_failure_ratio": 0.25,
  "workflow_min_runs": 4,
  "queued_run_max_minutes": 45,
  "notification_agent_error_ratio": 0.3,
  "notification_agent_min_reports": 4,
  "runners": ["wat2do-mac-deploy", "wat2do-scraper-1", "wat2do-scraper-2"],
  "emulator_restarts_per_day": 6,
  "qemu_cpu_percent": 300,
  "disk_free_gb_yellow": 20,
  "disk_free_gb_red": 10,
  "swap_used_gb_red": 12,
  "keep_alive_agents": [
    "io.wat2do.ingestion.process",
    "io.wat2do.instagram-browser.worker",
    "io.wat2do.instagram.worker",
    "io.wat2do.instagram-emulator",
    "io.wat2do.notification-recorder",
    "io.wat2do.api",
    "io.wat2do.postgres",
    "io.wat2do.postgrest",
    "actions.runner.wat2dov2-wat2do-ui.wat2do-mac-deploy",
    "actions.runner.wat2dov2-wat2do-ui.wat2do-scraper-1",
    "actions.runner.wat2dov2-wat2do-ui.wat2do-scraper-2"
  ],
  "scheduled_agents": [
    "io.wat2do.instagram.curate",
    "io.wat2do.notification-retry",
    "io.wat2do.ingestion.directories",
    "io.wat2do.prompts-autocommit",
    "io.wat2do.scheduled-emails",
    "io.wat2do.instagram-account-stats"
  ],
  "retry_log_max_minutes": 30,
  "sittings_check_hour": 13,
  "carousels_check_hour": 12,
  "snapshot_max_age_days": 1,
  "follow_sync_hours": 3,
  "follow_backlog_days": 7
}
