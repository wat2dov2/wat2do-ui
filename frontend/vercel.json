{
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://wat2do-api-production.up.railway.app/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://wat2do-api-production.up.railway.app/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
