# The API's origin. The browser always calls /api on the site's own origin,
# which next.config.ts rewrites here; server code calls it directly.
# Production: https://api.wat2do.io
API_URL=http://localhost:8000

# Mapbox token for QR scan maps.
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# Google Maps browser key for event location maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Google Analytics measurement ID is configured in backend/controlbox/google_analytics.json.

# Use the full Git SHA for deterministic production Next.js build IDs.
APP_VERSION=local-development

# Server-only at runtime. Never prefix this value with NEXT_PUBLIC_.
EVENT_FEED_REVALIDATION_SECRET=your-shared-revalidation-secret

# Shared secret the backend sends when it asks /api/render-instagram-slide to
# rasterize a carousel slide. Server-only; must match the backend's
# INSTAGRAM_SLIDE_RENDER_SECRET.
INSTAGRAM_SLIDE_RENDER_SECRET=your-shared-slide-render-secret

# Storage origin the slide renderer is allowed to inline posters from.
# Same value as the backend's STORAGE_PUBLIC_BASE_URL.
STORAGE_PUBLIC_BASE_URL=https://wat2do.io/media
