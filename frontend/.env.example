# Public API base URL used by the browser.
# Local: http://localhost:8000
# Production: /api (same-origin CloudFront request)
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
API_REWRITE_URL=http://localhost:8000

# Mapbox token for QR scan maps.
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# Google Maps browser key for event location maps.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# PostHog product analytics + session replay.
# Create a project at https://us.posthog.com (or https://eu.posthog.com),
# then paste the project token from Project Settings.
# Leave unset locally - PostHog is disabled on localhost / development.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Use the full Git SHA for deterministic production Next.js build IDs.
APP_VERSION=local-development

# Server-only at runtime. Never prefix this value with NEXT_PUBLIC_.
EVENT_FEED_REVALIDATION_SECRET=your-shared-revalidation-secret
