# The Mac mini's one origin. cloudflared sends every request for wat2do.io and
# *.wat2do.io here; nothing listens on a public interface.
{
	admin off
	auto_https off
	persist_config off
}

# Uploaded and ingested media, at their public URLs (https://wat2do.io/media/...).
(media) {
	handle /media/* {
		root * {$WAT2DO_DATA}
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		# A sanitized SVG still downloads instead of rendering on our origin.
		@svg path *.svg
		header @svg Content-Disposition attachment
		file_server
	}
}

# The API host. The website on Vercel rewrites /api/* and /media/* here
# (frontend/next.config.ts), and its proxy (frontend/src/proxy.ts) adds the
# visitor's address and the shared X-Wat2Do-Origin-Verify secret. Only a
# request carrying that secret keeps its X-Wat2Do-Viewer-Ip; any other request
# gets Cloudflare's CF-Connecting-IP instead, whatever it sent. The API trusts
# the header from loopback (core/client_ip.py, rust/src/api/client_ip.rs).
http://api.wat2do.io:8080 {
	bind 127.0.0.1

	import media

	# Never true without the secret (an unset ORIGIN_VERIFY_SECRET trusts no one).
	@website expression `{http.request.header.X-Wat2Do-Origin-Verify} == "{$ORIGIN_VERIFY_SECRET}" && "{$ORIGIN_VERIFY_SECRET}" != ""`
	handle @website {
		reverse_proxy 127.0.0.1:8000 {
			header_up -X-Wat2Do-Origin-Verify
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Wat2Do-Viewer-Ip {http.request.header.CF-Connecting-IP}
		}
	}
}

# wat2do.io and every school subdomain on the Mac's own Next server: the
# rollback while the website moves to Vercel, removed once Vercel is verified.
http://:8080 {
	bind 127.0.0.1

	import media

	# Everything else, including /api/*, which Next proxies to the API on 8000.
	# Cloudflare's CF-Connecting-IP becomes the viewer address the API trusts from
	# loopback; setting it here replaces any value a visitor sends.
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Wat2Do-Viewer-Ip {http.request.header.CF-Connecting-IP}
		}
	}
}
