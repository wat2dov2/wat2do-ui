# The Mac mini's one origin. cloudflared sends every request for wat2do.io and
# *.wat2do.io here; nothing listens on a public interface.
{
	admin off
	auto_https off
	persist_config off
}

http://:8080 {
	bind 127.0.0.1

	# Uploaded and ingested media, at the same URLs S3 served them from.
	handle /media/* {
		root * {$WAT2DO_DATA}
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		# A sanitized SVG still downloads instead of rendering on our origin.
		@svg path *.svg
		header @svg Content-Disposition attachment
		file_server
	}

	# Everything else, including /api/*, which Next proxies to the API on 8000.
	# Cloudflare's CF-Connecting-IP becomes the viewer address the API trusts from
	# loopback (core/client_ip.py, rust/src/api/client_ip.rs); setting it here
	# replaces any value a visitor sends.
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Wat2Do-Viewer-Ip {http.request.header.CF-Connecting-IP}
		}
	}
}
