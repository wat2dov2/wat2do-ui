#!/bin/bash
# The Mac's one origin (Caddy on 127.0.0.1:8080) from the current release's
# Caddyfile. caddy.env holds ORIGIN_VERIFY_SECRET, which the website's proxy on
# Vercel sends to api.wat2do.io with each visitor's address.
set -euo pipefail
data="$HOME/wat2do-data"
set -a
. "$data/config/caddy.env"
set +a
export WAT2DO_DATA="$data" XDG_DATA_HOME="$data/caddy" XDG_CONFIG_HOME="$data/caddy"
exec /opt/homebrew/bin/caddy run \
  --config "$data/releases/current/infra/mac-mini/Caddyfile" --adapter caddyfile
