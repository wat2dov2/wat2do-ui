# The CI/CD deploy job copies infra/vercel/ into its checkout and uploads the
# repository to Vercel, which builds the website (Root Directory frontend/).
# The website reads only backend/controlbox from outside frontend/, so
# everything else stays on the Mac.
/*
!/frontend
!/backend
/backend/*
!/backend/controlbox
/frontend/test-results
/frontend/playwright-report
/frontend/.deploy-lock-stamp
